{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/hooksmith/dist/src/run-log.js write-edit $CLAUDE_TOOL_NAME 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/hooksmith/dist/src/run-log.js session-start 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/hooksmith/dist/src/run-log.js session-end 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
