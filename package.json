{
  "name": "hooksmith",
  "version": "0.1.0",
  "private": true,
  "description": "Generate, lint and fire-test lifecycle hooks for coding agents.",
  "author": "Naman Parikh (https://github.com/naman10parikh)",
  "repository": { "type": "git", "url": "git+https://github.com/naman10parikh/hooksmith.git" },
  "homepage": "https://github.com/naman10parikh/hooksmith#readme",
  "type": "module",
  "bin": { "hooksmith": "./dist/src/cli.js", "hooksmith-mcp": "./dist/src/mcp-server.js" },
  "main": "./dist/src/generator.js",
  "types": "./dist/src/generator.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "eval": "vitest run evals",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm test",
    "hooksmith": "tsx src/cli.ts",
    "prepare": "tsc"
  },
  "files": ["dist/", "catalog/", "identity/", "skills/", "README.md"],
  "engines": { "node": ">=18" },
  "keywords": ["claude-code", "hooks", "lifecycle", "harness", "agent", "settings", "agent-native", "self-improving", "mcp", "agent-skills"],
  "license": "MIT",
  "optionalDependencies": {
    "e2b": "^2.56.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.19.0"
  }
}
