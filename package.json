{
  "name": "hooksmith",
  "version": "0.1.0",
  "private": true,
  "description": "Lifecycle-hook generator, linter, and verifier for Claude Code — the hooks component of the Energy fleet.",
  "type": "module",
  "bin": { "hooksmith": "./dist/src/cli.js" },
  "main": "./dist/src/generator.js",
  "types": "./dist/src/generator.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm build && pnpm test",
    "hooksmith": "tsx src/cli.ts"
  },
  "files": ["dist/", "catalog/", "README.md"],
  "engines": { "node": ">=18" },
  "keywords": ["claude-code", "hooks", "lifecycle", "harness", "agent", "settings"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "tsx": "^4.19.0"
  }
}
